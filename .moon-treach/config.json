{
  "schema_version": 1,
  "repository": "bboroski/Fragile-Baby",
  "default_base": "main",
  "fallback": "all",
  "fleet": [
    "bboroski/SAMBU",
    "bboroski/ToolNG",
    "bboroski/ReaperCripple",
    "bboroski/Kloz",
    "bboroski/CO",
    "bboroski/SaintSI",
    "bboroski/Klipot",
    "bboroski/NUN",
    "bboroski/NUNLauncher",
    "bboroski/Fragile-Baby",
    "bboroski/Luci",
    "bboroski/Hellduck",
    "bboroski/9circ"
  ],
  "suites": [
    {
      "id": "fragile-evidence",
      "description": "Run the documented evidence advisor; this is not hardware qualification",
      "paths": [
        "**/*.py",
        "**/*.json",
        "**/*.md",
        "**/*.yml",
        "**/*.yaml"
      ],
      "steps": [
        {
          "name": "Run evidence advisor",
          "command": [
            "python",
            "tools/evidence_advisor.py"
          ],
          "cwd": "."
        }
      ],
      "runs_on": "ubuntu-latest",
      "timeout_seconds": 1200
    }
  ],
  "policy": {
    "auto_merge": false,
    "required_checks_must_pass": true,
    "draft_prs_block_merge": true,
    "merge_conflicts_block_merge": true,
    "never_bypass_branch_protection": true,
    "no_suite_means_unverified": true
  }
}
